{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DomainCapabilitiesCatalog",
  "type": "object",
  "required": ["version", "generatedAt", "sha256", "entries"],
  "properties": {
    "version": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["supports2FA", "supportsPasskeys", "sources"],
        "properties": {
          "supports2FA": { "type": "boolean" },
          "supportsPasskeys": { "type": "boolean" },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
